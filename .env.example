# ═══════════════════════════════════════════════════════
# SERVER
# ═══════════════════════════════════════════════════════
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ═══════════════════════════════════════════════════════
# DATABASE (PostgreSQL)
# ═══════════════════════════════════════════════════════
# Nếu dùng docker-compose:
DATABASE_URL=postgresql://nha_hang_user:nha_hang_pass@localhost:5432/nha_hang_db
# Nếu dùng Postgres local:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nha_hang_db

DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# ═══════════════════════════════════════════════════════
# JWT
# ═══════════════════════════════════════════════════════
JWT_ACCESS_SECRET=change-me-access-secret-min-32-char-in-prod
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-char-in-prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ═══════════════════════════════════════════════════════
# LOG
# ═══════════════════════════════════════════════════════
LOG_LEVEL=debug